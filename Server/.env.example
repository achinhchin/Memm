# copy to .env and adjust
ADDR=:5050
MONGO_URI=mongodb://localhost:27017
MONGO_DB=memm

# path to the Client repo checkout (clone it next to Server)
CLIENT_DIR=../Client

# TLS: leave TLS=0 to serve plain http for local testing
TLS=1
CERT_FILE=./certs/cert.pem
KEY_FILE=./certs/key.pem

# blob storage root
DATA_DIR=./data

# max single upload chunk (bytes)
MAX_CHUNK=16777216

# set 1 to rebuild the inlined client bundle on every request (dev)
DEV=0
